# Copy to .env and fill in. .env is gitignored.

# LLM providers, tried in order. Any OpenAI-compatible endpoint works.
LLM_PROVIDERS=gemini,groq,ollama
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-flash-latest
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=gemma3
# OPENAI_BASE_URL=   # any other OpenAI-compatible server
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Set to a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string
# DATABASE_URL=postgresql+psycopg://user:pass@host/thiran
